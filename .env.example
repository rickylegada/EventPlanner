# Copy this file to .env.local and fill in real values.
# Never commit .env.local — it holds secrets.

# From your Supabase project: Settings -> Data API -> Project URL
SUPABASE_URL=https://xxxxxxxxxxxxxxxx.supabase.co

# From your Supabase project: Settings -> API Keys -> service_role (secret)
# This key bypasses all database rules. It stays server-side only and is never
# sent to the browser. Do not paste it anywhere public.
SUPABASE_SERVICE_ROLE_KEY=

# The passcode you share with the group chat. Anything you like.
APP_PASSCODE="sweatshow"

# Used to sign the login cookie. Generate with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
AUTH_SECRET=
